/*
 * Stub obsconfig.h for building against the libobs headers without running
 * the libobs CMake configure step (libobs/obsconfig.h is normally generated
 * from obsconfig.h.in). Plugins only need these to make obs-config.h parse;
 * the values match a Windows x64 OBS install. Generated by CMakeLists.txt.
 *
 * SPDX-License-Identifier: GPL-2.0-or-later
 */
#pragma once

#define OBS_DATA_PATH "../../data"
#define OBS_PLUGIN_PATH "../../obs-plugins/64bit"
#define OBS_PLUGIN_DESTINATION "obs-plugins/64bit"
#define OBS_INSTALL_PREFIX ""

#define OBS_RELEASE_CANDIDATE 0
#define OBS_BETA 0
