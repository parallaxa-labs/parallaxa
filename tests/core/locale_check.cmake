# Checks data/locale/{en-US,ja-JP,id-ID}.ini against the UX contract:
# - the key set is exactly the section 8 table of docs/ux/stage-plugin-ux.md
#   (plus Stage.Description, which obs_module_description needs);
# - the filter display names (Stage.Filter.*) are the English product names in
#   every language;
# - OBS-visible names say "Parallaxa" (filters, Tools menu, hotkeys "Parallaxa: ...",
#   AI hotkeys "AI Live Studio: ..."), never the internal prefix "Stage";
# - no duplicate keys, no BOM, every non-comment line is Key="Value" with inner
#   quotes escaped (OBS ends a value at the first unescaped quote).
# The files are generated by tools/gen-locale.py from that table.
# Without the spec (e.g. a source tarball without docs/), it falls back to
# "same keys as en-US.ini".
# Usage: cmake [-DLOCALE_DIR=<dir>] [-DSPEC=<stage-plugin-ux.md>] -P locale_check.cmake
# Copyright (C) 2026 Parallaxa Labs
# SPDX-License-Identifier: GPL-2.0-or-later
cmake_minimum_required(VERSION 3.25)

if(NOT LOCALE_DIR)
  get_filename_component(LOCALE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../data/locale" ABSOLUTE)
endif()
if(NOT SPEC)
  get_filename_component(SPEC "${CMAKE_CURRENT_LIST_DIR}/../../docs/ux/stage-plugin-ux.md" ABSOLUTE)
endif()

# read_ini(<file> <keys_var> <values_prefix>): key list in <keys_var>, each
# value in <values_prefix>_<key>.
function(read_ini file keys_var prefix)
  file(READ "${file}" _hex HEX LIMIT 3)
  if(_hex STREQUAL "efbbbf")
    message(SEND_ERROR "${file}: UTF-8 BOM not allowed")
  endif()
  file(STRINGS "${file}" _lines ENCODING UTF-8)
  set(_keys)
  set(_n 0)
  foreach(_l IN LISTS _lines)
    math(EXPR _n "${_n} + 1")
    if(_l MATCHES "^[ \t]*$" OR _l MATCHES "^#")
      continue()
    endif()
    if(NOT _l MATCHES "^([A-Za-z0-9_.]+)=\"(.*)\"$")
      message(SEND_ERROR "${file}:${_n}: not Key=\"Value\": ${_l}")
      continue()
    endif()
    set(_k "${CMAKE_MATCH_1}")
    set(_v "${CMAKE_MATCH_2}")
    string(REPLACE "\\\"" "" _unesc "${_v}")
    if(_unesc MATCHES "\"")
      message(SEND_ERROR "${file}:${_n}: unescaped quote in value of ${_k}")
    endif()
    if(_v STREQUAL "")
      message(SEND_ERROR "${file}:${_n}: empty value for ${_k}")
    endif()
    if(_k IN_LIST _keys)
      message(SEND_ERROR "${file}:${_n}: duplicate key ${_k}")
    endif()
    list(APPEND _keys "${_k}")
    set(${prefix}_${_k} "${_v}" PARENT_SCOPE)
  endforeach()
  set(${keys_var} "${_keys}" PARENT_SCOPE)
endfunction()

# Expected key list: section 8 rows "| `Stage.X` | EN | JA | ID |".
set(EXPECTED)
set(_source "en-US.ini")
if(EXISTS "${SPEC}")
  file(STRINGS "${SPEC}" _spec ENCODING UTF-8)
  set(_in8 FALSE)
  foreach(_l IN LISTS _spec)
    if(_l MATCHES "^## 8\\.")
      set(_in8 TRUE)
    elseif(_l MATCHES "^## ")
      set(_in8 FALSE)
    elseif(_in8 AND _l MATCHES "^\\| *`(Stage\\.[A-Za-z0-9_.]+)` *\\|")
      list(APPEND EXPECTED "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  list(LENGTH EXPECTED _n)
  if(_n LESS 100)
    message(SEND_ERROR "${SPEC}: section 8 table not found or too short (${_n} keys)")
  endif()
  set(_source "docs/ux/stage-plugin-ux.md section 8")
else()
  message(STATUS "locale_check: ${SPEC} not found, comparing against en-US.ini only")
endif()
if(NOT "Stage.Description" IN_LIST EXPECTED)
  list(APPEND EXPECTED "Stage.Description")
endif()

read_ini("${LOCALE_DIR}/en-US.ini" EN EN)
if(NOT EXISTS "${SPEC}")
  set(EXPECTED "${EN}")
endif()
list(LENGTH EXPECTED _count)

foreach(_loc IN ITEMS en-US ja-JP id-ID)
  read_ini("${LOCALE_DIR}/${_loc}.ini" K V)
  foreach(_k IN LISTS EXPECTED)
    if(NOT _k IN_LIST K)
      message(SEND_ERROR "${_loc}.ini: missing ${_k} (from ${_source})")
    endif()
  endforeach()
  foreach(_k IN LISTS K)
    if(NOT _k IN_LIST EXPECTED)
      message(SEND_ERROR "${_loc}.ini: key ${_k} is not in ${_source}")
    endif()
    # Filter display names are product names: English everywhere.
    if(_k MATCHES "^Stage\\.Filter\\." AND NOT "${V_${_k}}" STREQUAL "${EN_${_k}}")
      message(SEND_ERROR "${_loc}.ini: ${_k} must stay \"${EN_${_k}}\", got \"${V_${_k}}\"")
    endif()
    # OBS-visible names say "Parallaxa"; "Stage" is only the internal key/id
    # prefix. The AI hotkeys name AI Live Studio, the app they control.
    set(_v "${V_${_k}}")
    if(_k MATCHES "^Stage\\.Filter\\." AND NOT _v MATCHES "^Parallaxa ")
      message(SEND_ERROR "${_loc}.ini: ${_k} must start with \"Parallaxa \", got \"${_v}\"")
    elseif(_k MATCHES "^Stage\\.Hotkey\\.Ai")
      if(NOT _v MATCHES "^AI Live Studio: ")
        message(SEND_ERROR "${_loc}.ini: ${_k} must start with \"AI Live Studio: \", got \"${_v}\"")
      endif()
    elseif(_k MATCHES "^Stage\\.(Tools|Hotkey)\\." AND NOT _v MATCHES "^Parallaxa: ")
      message(SEND_ERROR "${_loc}.ini: ${_k} must start with \"Parallaxa: \", got \"${_v}\"")
    endif()
    if(_v MATCHES "(^|[^A-Za-z])Stage([^A-Za-z.]|$)")
      message(SEND_ERROR "${_loc}.ini: ${_k} shows the internal name \"Stage\": \"${_v}\"")
    endif()
  endforeach()
endforeach()

message(STATUS "locale_check: ${_count} keys (${_source}) in en-US/ja-JP/id-ID")
