{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "move.json",
  "title": "Stage camera move file (data/presets/moves/<id>.json)",
  "$comment": "SPDX-License-Identifier: MIT. File name must be <id>.json.",
  "type": "object",
  "required": ["id", "name", "duration_ms", "keys"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "vendor.common.json#/$defs/id" },
    "name": { "$ref": "vendor.common.json#/$defs/localized_name" },
    "duration_ms": { "$ref": "vendor.common.json#/$defs/duration_move" },
    "relative": { "type": "boolean", "default": true },
    "hold": { "type": "boolean", "default": false },
    "pro": { "type": "boolean", "default": false },
    "tags": { "$ref": "vendor.common.json#/$defs/tags" },
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/key" }
    }
  },
  "$defs": {
    "key": {
      "type": "object",
      "required": ["t"],
      "additionalProperties": false,
      "properties": {
        "t": { "type": "number", "minimum": 0, "maximum": 1 },
        "dx": { "type": "number", "minimum": -1, "maximum": 1 },
        "dy": { "type": "number", "minimum": -1, "maximum": 1 },
        "dzoom": { "type": "number", "minimum": -0.9, "maximum": 3 },
        "drot": { "type": "number", "minimum": -45, "maximum": 45 },
        "shake": { "type": "number", "minimum": 0, "maximum": 1 },
        "ease": { "$ref": "vendor.common.json#/$defs/ease" }
      }
    }
  }
}
